# Copy this file to .dev.vars for local Wrangler development.
# NEVER commit .dev.vars — it is listed in .gitignore.

# Your OpenAI API key. Set as a secret — never a plain var.
# Local:      add to .dev.vars below
# Production: wrangler secret put OPENAI_API_KEY
OPENAI_API_KEY=sk-proj-YOUR_KEY_HERE
